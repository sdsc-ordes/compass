# Copy to .env at the repository root. Read by docker-compose.yml (variable
# substitution), src/backend/app/core/settings.py, src/frontend/vite.config.ts
# and the turtle generator (COMPASS_USE_CASE only).

# Backend deployment settings (src/backend/app/core/settings.py)
# Secret for POST /api/v1/admin/reload; empty disables the endpoint.
COMPASS_RELOAD_TOKEN=
# Folder under src/ontology/ holding source-data.ods, compass.ttl and vocab.ttl.
COMPASS_USE_CASE=oceancare
# Host port of `just deploy` (nginx) and API port of `just backend` / `just dev-up`.
COMPASS_HTTP_PORT=8780
# Origins allowed to call the API cross-origin; empty disables CORS. Must include
# the widget dev server origin (COMPASS_DEV_PORT) and any site embedding the widget.
COMPASS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Relative to the working directory (src/backend under `just backend`).
# docker-compose.yml sets its own value.
COMPASS_ONTOLOGY_DIR=../ontology

# Widget dev server (src/frontend/vite.config.ts)
COMPASS_DEV_PORT=5173
# apiurl of the dev page. Default: http://localhost:$COMPASS_HTTP_PORT.
# COMPASS_API_URL=http://localhost:8780

# Use-case settings (src/backend/app/config.py)
API_TITLE=Compass API
API_WELCOME_MESSAGE=Compass API is running.
STORIES_PROVIDER_NAME=OceanCare
STORIES_BASE_URL_EN=https://www.oceancare.org/en/stories-and-news/
STORIES_BASE_URL_DE=https://www.oceancare.org/de/storys-and-news/
STORIES_API_URL=https://www.oceancare.org/wp-json/wp/v2/stories
STORIES_API_ERROR_MESSAGE=Unable to load story count. Please try again or contact OceanCare.
