# Backend environment template.
# Copy this file to `.env` in the project root. Variables here are used both by
# Docker Compose (which reads .env automatically) and by the backend when run
# locally with uv. In Docker, Compose injects these values; locally, settings.py
# loads the .env file if it exists.

# Platform settings (app/core/settings.py)
COMPASS_RELOAD_TOKEN=change-me
COMPASS_USE_CASE=oceancare # subdirectory under the ontology for compass.ttl / vocab.ttl
COMPASS_HTTP_PORT=8780 # Host port for `just deploy` (nginx) and default for `just backend` / `just dev-up`.
# Deployment settings (local runs without Docker compose)
COMPASS_ENVIRONMENT=development #set to production by default in the Dockerfile
COMPASS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173 # for local development. These are defaults used in the tests, keep them.
COMPASS_ONTOLOGY_DIR=../ontology # for local development only. relative to the backend folder.


# Use-case settings (app/config.py)
API_TITLE=Compass API
API_WELCOME_MESSAGE=Compass API is running.
STORIES_PROVIDER_NAME=OceanCare
STORIES_BASE_URL_EN=https://www.oceancare.org/en/stories-and-news/
STORIES_BASE_URL_DE=https://www.oceancare.org/de/storys-and-news/
STORIES_API_URL=https://www.oceancare.org/wp-json/wp/v2/stories
STORIES_API_ERROR_MESSAGE=Unable to load story count. Please try again or contact OceanCare.
