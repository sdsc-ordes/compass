@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix compass: <http://example.org/ocean-org/ontology#> .

# ============================================================
# SKOS Controlled Vocabularies: OceanCare Compass Tag Dimensions
# ============================================================

# ============================================================
# 1. Work Area (4 concepts)
# ============================================================

compass:WorkAreaScheme a skos:ConceptScheme ;
    skos:prefLabel "Work Area"@en ;
    skos:prefLabel "Arbeitsbereich"@de ;
    skos:definition "Types of work OceanCare performs."@en ;
    skos:hasTopConcept compass:AdvocacyWork ;
    skos:hasTopConcept compass:ScientificResearch ;
    skos:hasTopConcept compass:RescueActivities ;
    skos:hasTopConcept compass:CommunityInvolvement ;
    dct:isPartOf <http://example.org/ocean-org/ontology> .

compass:AdvocacyWork a skos:Concept, compass:WorkArea ;
    skos:prefLabel "Advocacy Work"@en ;
    skos:prefLabel "Lobbyarbeit"@de ;
    skos:inScheme compass:WorkAreaScheme ;
    skos:topConceptOf compass:WorkAreaScheme .

compass:ScientificResearch a skos:Concept, compass:WorkArea ;
    skos:prefLabel "Scientific Research"@en ;
    skos:prefLabel "Wissenschaftliche Forschung"@de ;
    skos:inScheme compass:WorkAreaScheme ;
    skos:topConceptOf compass:WorkAreaScheme .

compass:RescueActivities a skos:Concept, compass:WorkArea ;
    skos:prefLabel "Rescue Activities"@en ;
    skos:prefLabel "Rettungsaktivitäten"@de ;
    skos:inScheme compass:WorkAreaScheme ;
    skos:topConceptOf compass:WorkAreaScheme .

compass:CommunityInvolvement a skos:Concept, compass:WorkArea ;
    skos:prefLabel "Community Involvement"@en ;
    skos:prefLabel "Gemeinschaftsbeteiligung"@de ;
    skos:inScheme compass:WorkAreaScheme ;
    skos:topConceptOf compass:WorkAreaScheme .

# ============================================================
# 2. Conservation (2 concepts)
# ============================================================

compass:ConservationScheme a skos:ConceptScheme ;
    skos:prefLabel "Conservation"@en ;
    skos:prefLabel "Schutz"@de ;
    skos:definition "Conservation focus areas."@en ;
    skos:hasTopConcept compass:OceanConservation ;
    skos:hasTopConcept compass:AnimalAndSpeciesConservation ;
    dct:isPartOf <http://example.org/ocean-org/ontology> .

compass:OceanConservation a skos:Concept, compass:Conservation ;
    skos:prefLabel "Ocean Conservation"@en ;
    skos:prefLabel "Meeresschutz"@de ;
    skos:inScheme compass:ConservationScheme ;
    skos:topConceptOf compass:ConservationScheme .

compass:AnimalAndSpeciesConservation a skos:Concept, compass:Conservation ;
    skos:prefLabel "Animal and Species Conservation"@en ;
    skos:prefLabel "Tier- und Artenschutz"@de ;
    skos:inScheme compass:ConservationScheme ;
    skos:topConceptOf compass:ConservationScheme ;
    compass:wpTagId "455"^^xsd:integer .

# ============================================================
# 3. Topic (7 concepts)
# ============================================================

compass:TopicScheme a skos:ConceptScheme ;
    skos:prefLabel "Topic"@en ;
    skos:prefLabel "Thema"@de ;
    skos:definition "Thematic topics addressed by OceanCare."@en ;
    skos:hasTopConcept compass:ClimateProtection ;
    skos:hasTopConcept compass:DeepSeaMining ;
    skos:hasTopConcept compass:Geoengineering ;
    skos:hasTopConcept compass:Hunting ;
    skos:hasTopConcept compass:Fisheries ;
    skos:hasTopConcept compass:Shipping ;
    skos:hasTopConcept compass:FossilFuels ;
    dct:isPartOf <http://example.org/ocean-org/ontology> .

compass:ClimateProtection a skos:Concept, compass:Topic ;
    skos:prefLabel "Climate Protection"@en ;
    skos:prefLabel "Klimaschutz"@de ;
    skos:inScheme compass:TopicScheme ;
    skos:topConceptOf compass:TopicScheme .

compass:DeepSeaMining a skos:Concept, compass:Topic ;
    skos:prefLabel "Deep-Sea Mining"@en ;
    skos:prefLabel "Tiefseebergbau"@de ;
    skos:inScheme compass:TopicScheme ;
    skos:topConceptOf compass:TopicScheme .

compass:Geoengineering a skos:Concept, compass:Topic ;
    skos:prefLabel "Geoengineering"@en ;
    skos:prefLabel "Geoengineering"@de ;
    skos:inScheme compass:TopicScheme ;
    skos:topConceptOf compass:TopicScheme .

compass:Hunting a skos:Concept, compass:Topic ;
    skos:prefLabel "Hunting"@en ;
    skos:prefLabel "Jagd"@de ;
    skos:inScheme compass:TopicScheme ;
    skos:topConceptOf compass:TopicScheme .

compass:Fisheries a skos:Concept, compass:Topic ;
    skos:prefLabel "Fisheries"@en ;
    skos:prefLabel "Fischerei"@de ;
    skos:inScheme compass:TopicScheme ;
    skos:topConceptOf compass:TopicScheme .

compass:Shipping a skos:Concept, compass:Topic ;
    skos:prefLabel "Shipping"@en ;
    skos:prefLabel "Schifffahrt"@de ;
    skos:inScheme compass:TopicScheme ;
    skos:topConceptOf compass:TopicScheme .

compass:FossilFuels a skos:Concept, compass:Topic ;
    skos:prefLabel "Fossil Fuels"@en ;
    skos:prefLabel "Fossile Brennstoffe"@de ;
    skos:inScheme compass:TopicScheme ;
    skos:topConceptOf compass:TopicScheme .

# ============================================================
# 4. Pollution (3 concepts)
# ============================================================

compass:PollutionScheme a skos:ConceptScheme ;
    skos:prefLabel "Pollution"@en ;
    skos:prefLabel "Verschmutzung"@de ;
    skos:definition "Types of ocean pollution."@en ;
    skos:hasTopConcept compass:OceanNoisePollution ;
    skos:hasTopConcept compass:PlasticPollution ;
    skos:hasTopConcept compass:ChemicalPollution ;
    dct:isPartOf <http://example.org/ocean-org/ontology> .

compass:OceanNoisePollution a skos:Concept, compass:Pollution ;
    skos:prefLabel "Ocean Noise Pollution"@en ;
    skos:prefLabel "Unterwasserlärm"@de ;
    skos:inScheme compass:PollutionScheme ;
    skos:topConceptOf compass:PollutionScheme .

compass:PlasticPollution a skos:Concept, compass:Pollution ;
    skos:prefLabel "Plastic Pollution"@en ;
    skos:prefLabel "Plastikverschmutzung"@de ;
    skos:inScheme compass:PollutionScheme ;
    skos:topConceptOf compass:PollutionScheme .

compass:ChemicalPollution a skos:Concept, compass:Pollution ;
    skos:prefLabel "Chemical Pollution"@en ;
    skos:prefLabel "Chemische Verschmutzung"@de ;
    skos:inScheme compass:PollutionScheme ;
    skos:topConceptOf compass:PollutionScheme .

# ============================================================
# 5. Species (9 concepts)
# ============================================================

compass:SpeciesScheme a skos:ConceptScheme ;
    skos:prefLabel "Species"@en ;
    skos:prefLabel "Arten"@de ;
    skos:definition "Marine and aquatic species relevant to OceanCare's work."@en ;
    skos:hasTopConcept compass:Dolphins ;
    skos:hasTopConcept compass:Whales ;
    skos:hasTopConcept compass:Orcas ;
    skos:hasTopConcept compass:SeaTurtles ;
    skos:hasTopConcept compass:Seals ;
    skos:hasTopConcept compass:PolarBears ;
    skos:hasTopConcept compass:Manatees ;
    skos:hasTopConcept compass:Sharks ;
    skos:hasTopConcept compass:Fish ;
    skos:hasTopConcept compass:Corals ;
    dct:isPartOf <http://example.org/ocean-org/ontology> .

compass:Dolphins a skos:Concept, compass:Species ;
    skos:prefLabel "Dolphins"@en ;
    skos:prefLabel "Delfine"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme ;
    compass:wpTagId "148"^^xsd:integer .

compass:Whales a skos:Concept, compass:Species ;
    skos:prefLabel "Whales"@en ;
    skos:prefLabel "Wale"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme ;
    compass:wpTagId "147"^^xsd:integer .

compass:Orcas a skos:Concept, compass:Species ;
    skos:prefLabel "Orcas"@en ;
    skos:prefLabel "Orcas"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme .

compass:SeaTurtles a skos:Concept, compass:Species ;
    skos:prefLabel "Sea Turtles"@en ;
    skos:prefLabel "Meeresschildkröten"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme .

compass:Seals a skos:Concept, compass:Species ;
    skos:prefLabel "Seals"@en ;
    skos:prefLabel "Robben"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme .

compass:PolarBears a skos:Concept, compass:Species ;
    skos:prefLabel "Polar Bears"@en ;
    skos:prefLabel "Eisbären"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme .

compass:Manatees a skos:Concept, compass:Species ;
    skos:prefLabel "Manatees"@en ;
    skos:prefLabel "Manatis"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme .

compass:Sharks a skos:Concept, compass:Species ;
    skos:prefLabel "Sharks"@en ;
    skos:prefLabel "Haie"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme .

compass:Fish a skos:Concept, compass:Species ;
    skos:prefLabel "Fish"@en ;
    skos:prefLabel "Fische"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme .

compass:Corals a skos:Concept, compass:Species ;
    skos:prefLabel "Corals"@en ;
    skos:prefLabel "Korallen"@de ;
    skos:inScheme compass:SpeciesScheme ;
    skos:topConceptOf compass:SpeciesScheme .

# ============================================================
# 6. Country / Area (20 concepts)
# ============================================================

compass:CountryAreaScheme a skos:ConceptScheme ;
    skos:prefLabel "Country / Area"@en ;
    skos:prefLabel "Land / Gebiet"@de ;
    skos:definition "Countries and geographic areas relevant to OceanCare's work."@en ;
    skos:hasTopConcept compass:Arctic ;
    skos:hasTopConcept compass:Australia ;
    skos:hasTopConcept compass:Benin ;
    skos:hasTopConcept compass:Bulgaria ;
    skos:hasTopConcept compass:England ;
    skos:hasTopConcept compass:FaroeIslands ;
    skos:hasTopConcept compass:France ;
    skos:hasTopConcept compass:Greece ;
    skos:hasTopConcept compass:Iceland ;
    skos:hasTopConcept compass:Italy ;
    skos:hasTopConcept compass:Japan ;
    skos:hasTopConcept compass:Maldives ;
    skos:hasTopConcept compass:Mauritania ;
    skos:hasTopConcept compass:NorthSeaBalticSea ;
    skos:hasTopConcept compass:Norway ;
    skos:hasTopConcept compass:Slovenia ;
    skos:hasTopConcept compass:Spain ;
    skos:hasTopConcept compass:Switzerland ;
    skos:hasTopConcept compass:Venezuela ;
    skos:hasTopConcept compass:EasternMediterraneanSea ;
    skos:hasTopConcept compass:WesternMediterraneanSea ;
    dct:isPartOf <http://example.org/ocean-org/ontology> .

compass:Arctic a skos:Concept, compass:CountryArea ;
    skos:prefLabel "Arctic"@en ;
    skos:prefLabel "Arktis"@de ;
    compass:conservation compass:OceanConservation, compass:AnimalAndSpeciesConservation ;
    compass:workArea compass:AdvocacyWork ;
    compass:topic compass:ClimateProtection, compass:Hunting, compass:Shipping, compass:FossilFuels ;
    compass:species compass:PolarBears ;
    skos:inScheme compass:CountryAreaScheme ;
    skos:topConceptOf compass:CountryAreaScheme .

compass:Australia a skos:Concept, compass:CountryArea ;
    skos:prefLabel "Australia"@en ;
    skos:prefLabel "Australien"@de ;
    compass:isoCode "AUS" ;
    compass:conservation compass:AnimalAndSpeciesConservation ;
    compass:topic compass:ClimateProtection ;
    compass:species compass:Corals ;
    skos:inScheme compass:CountryAreaScheme ;
    skos:topConceptOf compass:CountryAreaScheme .

compass:Benin a skos:Concept, compass:CountryArea ;
    skos:prefLabel "Benin"@en ;
    skos:prefLabel "Benin"@de ;
    compass:isoCode "BEN" ;
    compass:conservation compass:AnimalAndSpeciesConservation ;
    compass:workArea compass:AdvocacyWork, compass:ScientificResearch ;
    compass:topic compass:Fisheries, compass:Hunting ;
    compass:species compass:Dolphins, compass:Manatees, compass:SeaTurtles, compass:Sharks, compass:Fish ;
    skos:inScheme compass:CountryAreaScheme ;
    skos:topConceptOf compass:CountryAreaScheme .

compass:Bulgaria a skos:Concept, compass:CountryArea ;
    skos:prefLabel "Bulgaria"@en ;
    skos:prefLabel "Bulgarien"@de ;
    compass:isoCode "BGR" ;
    compass:conservation compass:AnimalAndSpeciesConservation ;
    compass:workArea compass:ScientificResearch, compass:AdvocacyWork ;
    compass:species compass:Dolphins ;
    skos:inScheme compass:CountryAreaScheme ;
    skos:topConceptOf compass:CountryAreaScheme .

compass:England a skos:Concept, compass:CountryArea ;
    skos:prefLabel "England"@en ;
    skos:prefLabel "England"@de ;
    compass:isoCode "GBR-ENG" ;
    compass:conservation compass:AnimalAndSpeciesConservation ;
    compass:workArea compass:RescueActivities, compass:ScientificResearch ;
    compass:pollution compass:PlasticPollution ;
    compass:species compass:Dolphins, compass:Seals, compass:Whales ;
    skos:inScheme compass:CountryAreaScheme ;
    skos:topConceptOf compass:CountryAreaScheme .

compass:FaroeIslands a skos:Concept, compass:CountryArea ;
    skos:prefLabel "Faroe Islands"@en ;
    skos:prefLabel "Färöer-Inseln"@de ;
    compass:isoCode "FRO" ;
    compass:conservation compass:AnimalAndSpeciesConservation ;
    compass:workArea compass:AdvocacyWork, compass:CommunityInvolvement ;
    compass:topic compass:Hunting ;
    compass:species compass:Dolphins, compass:Whales ;
    compass:pollution compass:ChemicalPollution ;
    skos:inScheme compass:CountryAreaScheme ;
    skos:topConceptOf compass:CountryAreaScheme .

compass:France a skos:Concept, compass:CountryArea ;
    skos:prefLabel "France"@en ;
    skos:prefLabel "Frankreich"@de ;
    compass:isoCode "FRA" ;
    compass:conservation compass:AnimalAndSpeciesConservation ;
    compass:workArea compass:RescueActivities, compass:ScientificResearch ;
    compass:species compass:Seals ;
    skos:inScheme compass:CountryAreaScheme ;
    skos:topConceptOf compass:CountryAreaScheme .

compass:Greece a skos:Concept, compass:CountryArea ;
    skos:prefLabel "Greece"@en ;
    skos:prefLabel "Griechenland"@de ;
