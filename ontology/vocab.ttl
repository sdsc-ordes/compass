compass:Japan a skos:Concept, compass:CountryArea ;
    skos:prefLabel "Japan"@en ;
    skos:prefLabel "Japan"@de ;
    compass:isoCode "JPN" ;
    compass:conservation compass:AnimalAndSpeciesConservation ;
