@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos:  <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:   <http://purl.org/dc/terms/> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .
@prefix compass: <http://example.org/ocean-org/ontology#> .

# ============================================================
# SKOS Controlled Vocabularies: OceanCare Compass
# ============================================================

# ============================================================
# Concept Scheme: Focus Area
# Each leaf concept carries schema:url pointing to its OceanCare story page.
# ============================================================

compass:FocusAreaScheme a skos:ConceptScheme ;
    skos:prefLabel "Focus Area"@en ;
    skos:prefLabel "Schwerpunktbereich"@de ;
    skos:definition "Controlled vocabulary for thematic research or activity focus areas."@en ;
    skos:definition "Kontrolliertes Vokabular für thematische Forschungs- oder Tätigkeitsschwerpunkte."@de ;
    skos:hasTopConcept compass:MarineBiology ;
    skos:hasTopConcept compass:PhysicalOceanography ;
    skos:hasTopConcept compass:ClimateScience ;
    skos:hasTopConcept compass:DeepSeaExploration ;
    skos:hasTopConcept compass:CoastalManagement ;
    skos:hasTopConcept compass:MarineGeology ;
    skos:hasTopConcept compass:FisheriesScience ;
    skos:hasTopConcept compass:PolarResearch ;
    dct:isPartOf <http://example.org/ocean-org/ontology> .

compass:MarineBiology a skos:Concept, compass:FocusArea ;
    skos:prefLabel "Marine Biology"@en ;
    skos:prefLabel "Meeresbiologie"@de ;
    skos:definition "Research focused on the organisms and ecosystems of the ocean."@en ;
    skos:topConceptOf compass:FocusAreaScheme ;
    skos:inScheme compass:FocusAreaScheme ;
    schema:url "https://www.oceancare.org/en/stories/marine-biology/"^^xsd:anyURI .

compass:PhysicalOceanography a skos:Concept, compass:FocusArea ;
    skos:prefLabel "Physical Oceanography"@en ;
    skos:prefLabel "Physikalische Ozeanographie"@de ;
    skos:definition "Study of ocean currents, waves, tides, and physical properties of seawater."@en ;
    skos:topConceptOf compass:FocusAreaScheme ;
    skos:inScheme compass:FocusAreaScheme ;
    schema:url "https://www.oceancare.org/en/stories/physical-oceanography/"^^xsd:anyURI .

compass:ClimateScience a skos:Concept, compass:FocusArea ;
    skos:prefLabel "Climate Science"@en ;
    skos:prefLabel "Klimawissenschaft"@de ;
    skos:definition "Research on climate systems, change, and ocean-atmosphere interactions."@en ;
    skos:topConceptOf compass:FocusAreaScheme ;
    skos:inScheme compass:FocusAreaScheme ;
    schema:url "https://www.oceancare.org/en/stories/climate-science/"^^xsd:anyURI .

compass:DeepSeaExploration a skos:Concept, compass:FocusArea ;
    skos:prefLabel "Deep-Sea Exploration"@en ;
    skos:prefLabel "Tiefsee-Exploration"@de ;
    skos:definition "Exploration and study of deep-ocean environments and organisms."@en ;
    skos:topConceptOf compass:FocusAreaScheme ;
    skos:inScheme compass:FocusAreaScheme ;
    schema:url "https://www.oceancare.org/en/stories/deep-sea-exploration/"^^xsd:anyURI .

compass:CoastalManagement a skos:Concept, compass:FocusArea ;
    skos:prefLabel "Coastal Management"@en ;
    skos:prefLabel "Küstenmanagement"@de ;
    skos:definition "Sustainable management of coastal zones and nearshore environments."@en ;
    skos:topConceptOf compass:FocusAreaScheme ;
    skos:inScheme compass:FocusAreaScheme ;
    schema:url "https://www.oceancare.org/en/stories/coastal-management/"^^xsd:anyURI .

compass:MarineGeology a skos:Concept, compass:FocusArea ;
    skos:prefLabel "Marine Geology"@en ;
    skos:prefLabel "Meeresgeologie"@de ;
    skos:definition "Study of seafloor geology, sediments, and tectonic processes."@en ;
    skos:topConceptOf compass:FocusAreaScheme ;
    skos:inScheme compass:FocusAreaScheme ;
    schema:url "https://www.oceancare.org/en/stories/marine-geology/"^^xsd:anyURI .

compass:FisheriesScience a skos:Concept, compass:FocusArea ;
    skos:prefLabel "Fisheries Science"@en ;
    skos:prefLabel "Fischereiwissenschaft"@de ;
    skos:definition "Research on fish populations, fisheries management, and aquaculture."@en ;
    skos:topConceptOf compass:FocusAreaScheme ;
    skos:inScheme compass:FocusAreaScheme ;
    schema:url "https://www.oceancare.org/en/stories/fisheries-science/"^^xsd:anyURI .

compass:PolarResearch a skos:Concept, compass:FocusArea ;
    skos:prefLabel "Polar Research"@en ;
    skos:prefLabel "Polarforschung"@de ;
    skos:definition "Research in Arctic and Antarctic ocean and ice environments."@en ;
    skos:topConceptOf compass:FocusAreaScheme ;
    skos:inScheme compass:FocusAreaScheme ;
    schema:url "https://www.oceancare.org/en/stories/polar-research/"^^xsd:anyURI .

# ============================================================
# Concept Scheme: Theme
# compass:isPublic distinguishes publicly visible themes from internal ones.
# ============================================================

compass:ThemeScheme a skos:ConceptScheme ;
    skos:prefLabel "Theme"@en ;
    skos:prefLabel "Thema"@de ;
    skos:definition "Controlled vocabulary for cross-cutting themes used to categorize entities."@en ;
    skos:definition "Kontrolliertes Vokabular für übergreifende Themen zur Kategorisierung von Entitäten."@de ;
    skos:hasTopConcept compass:Theme_OceanHealth ;
    skos:hasTopConcept compass:Theme_MarinePolicy ;
    skos:hasTopConcept compass:Theme_Biodiversity ;
    skos:hasTopConcept compass:Theme_ClimateResilience ;
    skos:hasTopConcept compass:Theme_CapacityBuilding ;
    skos:hasTopConcept compass:Theme_OceanGovernance ;
    dct:isPartOf <http://example.org/ocean-org/ontology> .

compass:Theme_OceanHealth a skos:Concept, compass:Theme ;
    skos:prefLabel "Ocean Health"@en ;
    skos:prefLabel "Meeresgesundheit"@de ;
    skos:definition "Initiatives and research addressing the overall health and resilience of ocean ecosystems."@en ;
    skos:definition "Initiativen und Forschung zur Gesundheit und Widerstandsfähigkeit von Meeresökosystemen."@de ;
    skos:topConceptOf compass:ThemeScheme ;
    skos:inScheme compass:ThemeScheme ;
    compass:isPublic true .

compass:Theme_MarinePolicy a skos:Concept, compass:Theme ;
    skos:prefLabel "Marine Policy"@en ;
    skos:prefLabel "Meerespolitik"@de ;
    skos:definition "Policy development, advocacy, and governance for ocean protection."@en ;
    skos:definition "Politikentwicklung, Interessenvertretung und Steuerung für den Meeresschutz."@de ;
    skos:topConceptOf compass:ThemeScheme ;
    skos:inScheme compass:ThemeScheme ;
    compass:isPublic true .

compass:Theme_Biodiversity a skos:Concept, compass:Theme ;
    skos:prefLabel "Biodiversity"@en ;
    skos:prefLabel "Biodiversität"@de ;
    skos:definition "Conservation and study of marine species diversity and ecosystems."@en ;
    skos:definition "Erhaltung und Erforschung der marinen Artenvielfalt und Ökosysteme."@de ;
    skos:topConceptOf compass:ThemeScheme ;
    skos:inScheme compass:ThemeScheme ;
    compass:isPublic true .

compass:Theme_ClimateResilience a skos:Concept, compass:Theme ;
    skos:prefLabel "Climate Resilience"@en ;
    skos:prefLabel "Klimaresilienz"@de ;
    skos:definition "Building ocean and coastal resilience in the face of climate change."@en ;
    skos:definition "Aufbau der Widerstands- und Anpassungsfähigkeit von Meer und Küste angesichts des Klimawandels."@de ;
    skos:topConceptOf compass:ThemeScheme ;
    skos:inScheme compass:ThemeScheme ;
    compass:isPublic true .

compass:Theme_CapacityBuilding a skos:Concept, compass:Theme ;
    skos:prefLabel "Capacity Building"@en ;
    skos:prefLabel "Kapazitätsaufbau"@de ;
    skos:definition "Internal programmes for training, partnership development, and institutional strengthening."@en ;
    skos:definition "Interne Programme für Ausbildung, Partnerschaftsentwicklung und institutionelle Stärkung."@de ;
    skos:topConceptOf compass:ThemeScheme ;
    skos:inScheme compass:ThemeScheme ;
    compass:isPublic false .

compass:Theme_OceanGovernance a skos:Concept, compass:Theme ;
    skos:prefLabel "Ocean Governance"@en ;
    skos:prefLabel "Meeresgovernance"@de ;
    skos:definition "International frameworks, treaties, and bodies governing the use and protection of the ocean."@en ;
    skos:definition "Internationale Rahmenwerke, Verträge und Gremien zur Steuerung und zum Schutz des Meeres."@de ;
    skos:topConceptOf compass:ThemeScheme ;
    skos:inScheme compass:ThemeScheme ;
    compass:isPublic true .
