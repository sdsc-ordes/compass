@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix compass: <http://example.org/ocean-org/ontology#> .
@prefix schema: <https://schema.org/> .

# ============================================================
# SHACL Shapes: OceanCare Compass Entities
# ============================================================

# ============================================================
# Classes
# ============================================================

compass:InternationalForum a rdfs:Class ;
    rdfs:label "International Forum"@en ;
    rdfs:label "Internationales Forum"@de ;
    rdfs:comment "An international policy, governance, or coordination forum for ocean affairs."@en ;
    rdfs:comment "Ein internationales Policy-, Governance- oder Koordinierungsforum für Meeresangelegenheiten."@de .

compass:Network a rdfs:Class ;
    rdfs:label "Network"@en ;
    rdfs:label "Netzwerk"@de ;
    rdfs:comment "A collaborative ocean research or monitoring network spanning multiple organizations."@en ;
    rdfs:comment "Ein kollaboratives Netzwerk für Meeresforschung oder -überwachung über mehrere Organisationen hinweg."@de .

compass:PartnerOrganization a rdfs:Class ;
    rdfs:label "Partner Organization"@en ;
    rdfs:label "Partnerorganisation"@de ;
    rdfs:comment "An OceanCare partner organization active in marine conservation or research."@en ;
    rdfs:comment "Eine OceanCare-Partnerorganisation, die im Meeresschutz oder in der Meeresforschung tätig ist."@de .

compass:Project a rdfs:Class ;
    rdfs:label "Project"@en ;
    rdfs:label "Projekt"@de ;
    rdfs:comment "A time-limited project or programme addressing ocean issues."@en ;
    rdfs:comment "Ein zeitlich begrenztes Projekt oder Programm zur Bewältigung von Meeresfragen."@de .

compass:FocusArea a rdfs:Class ;
    rdfs:label "Focus Area"@en ;
    rdfs:label "Schwerpunktbereich"@de ;
    rdfs:comment "A thematic research or activity focus area."@en ;
    rdfs:comment "Ein thematischer Forschungs- oder Tätigkeitsschwerpunkt."@de .

compass:Theme a rdfs:Class ;
    rdfs:label "Theme"@en ;
    rdfs:label "Thema"@de ;
    rdfs:comment "A cross-cutting theme used to categorize entities in the compass."@en ;
    rdfs:comment "Ein übergreifendes Thema zur Kategorisierung von Entitäten im Compass."@de .

# ============================================================
# Property Declarations
# All properties used as sh:path values must be typed as rdf:Property
# with rdfs:label and rdfs:comment to satisfy ordes:pathShape and
# ordes:conceptShape in shacl-shacl.ttl.
# ============================================================

compass:name a rdf:Property ;
    rdfs:label "name"@en ;
    rdfs:label "Name"@de ;
    rdfs:comment "The display name of the entity."@en .

compass:location a rdf:Property ;
    rdfs:label "location"@en ;
    rdfs:label "Ort"@de ;
    rdfs:comment "Human-readable location description (city, country)."@en .

compass:keySentence a rdf:Property ;
    rdfs:label "key sentence"@en ;
    rdfs:label "Kernsatz"@de ;
    rdfs:comment "A single sentence summarizing the entity."@en .

compass:managedByOceanCare a rdf:Property ;
    rdfs:label "managed by OceanCare"@en ;
    rdfs:label "verwaltet von OceanCare"@de ;
    rdfs:comment "Whether this entity is directly managed by OceanCare."@en .

compass:isPublic a rdf:Property ;
    rdfs:label "is public"@en ;
    rdfs:label "ist öffentlich"@de ;
    rdfs:comment "Whether this concept is publicly visible in the Compass UI."@en .

compass:startDate a rdf:Property ;
    rdfs:label "start date"@en ;
    rdfs:label "Startdatum"@de ;
    rdfs:comment "The start date of the project."@en .

# External properties used in sh:path (stub declarations; authoritative
# definitions live in the WGS84, Schema.org, and SKOS vocabularies).
geo:lat a rdf:Property ;
    rdfs:label "latitude"@en ;
    rdfs:comment "WGS84 latitude coordinate of a spatial thing."@en .

geo:long a rdf:Property ;
    rdfs:label "longitude"@en ;
    rdfs:comment "WGS84 longitude coordinate of a spatial thing."@en .

schema:foundingDate a rdf:Property ;
    rdfs:label "founding date"@en ;
    rdfs:comment "The date that this organization was founded."@en .

schema:url a rdf:Property ;
    rdfs:label "url"@en ;
    rdfs:comment "URL of the item."@en .

schema:image a rdf:Property ;
    rdfs:label "image"@en ;
    rdfs:comment "URL of an image or logo representing the entity."@en .

skos:prefLabel a rdf:Property ;
    rdfs:label "preferred label"@en ;
    rdfs:comment "The preferred lexical label for a resource, in a given language."@en .

# ============================================================
# Named Property Shapes (shared across entity NodeShapes)
# ============================================================

compass:NameShape a sh:Shape ;
    sh:path compass:name ;
    sh:name "name"@en ;
    sh:name "Name"@de ;
    sh:description "The display name of the entity."@en ;
    sh:description "Der Anzeigename der Entität."@de ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:uniqueLang true .

compass:LatShape a sh:Shape ;
    sh:path geo:lat ;
    sh:name "latitude"@en ;
    sh:name "Breitengrad"@de ;
    sh:description "WGS84 latitude."@en ;
    sh:datatype xsd:float ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive -90.0 ;
    sh:maxInclusive 90.0 ;
    sh:severity sh:Violation .

compass:LongShape a sh:Shape ;
    sh:path geo:long ;
    sh:name "longitude"@en ;
    sh:name "Längengrad"@de ;
    sh:description "WGS84 longitude."@en ;
    sh:datatype xsd:float ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive -180.0 ;
    sh:maxInclusive 180.0 ;
    sh:severity sh:Violation .

compass:LocationShape a sh:Shape ;
    sh:path compass:location ;
    sh:name "location"@en ;
    sh:name "Ort"@de ;
    sh:description "Human-readable location (city, country)."@en ;
    sh:description "Menschenlesbare Ortsangabe (Stadt, Land)."@de ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true .

compass:WebsiteUrlShape a sh:Shape ;
    sh:path schema:url ;
    sh:name "website URL"@en ;
    sh:name "Website-URL"@de ;
    sh:description "The entity's official website."@en ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 ;
    sh:severity sh:Warning .

compass:ImageShape a sh:Shape ;
    sh:path schema:image ;
    sh:name "logo"@en ;
    sh:name "Logo"@de ;
    sh:description "URL of an image or logo for the entity."@en ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 .

compass:KeySentenceShape a sh:Shape ;
    sh:path compass:keySentence ;
    sh:name "key sentence"@en ;
    sh:name "Kernsatz"@de ;
    sh:description "A single sentence summarizing the entity."@en ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true .

compass:ManagedByOceanCareShape a sh:Shape ;
    sh:path compass:managedByOceanCare ;
    sh:name "managed by OceanCare"@en ;
    sh:name "verwaltet von OceanCare"@de ;
    sh:description "Whether this entity is directly managed by OceanCare."@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

compass:FoundingDateShape a sh:Shape ;
    sh:path schema:foundingDate ;
    sh:name "founded year"@en ;
    sh:name "Gründungsjahr"@de ;
    sh:description "The year the entity was established."@en ;
    sh:datatype xsd:gYear ;
    sh:maxCount 1 .

compass:StartDateShape a sh:Shape ;
    sh:path compass:startDate ;
    sh:name "start date"@en ;
    sh:name "Startdatum"@de ;
    sh:description "The start date of the project."@en ;
    sh:datatype xsd:date ;
    sh:maxCount 1 .


# ============================================================
# SHACL Node Shapes: 4 entity types
# Each references the shared named property shapes above.
# ============================================================

compass:InternationalForumShape a sh:NodeShape ;
    sh:targetClass compass:InternationalForum ;
    rdfs:label "International Forum Shape"@en ;
    rdfs:label "Internationales Forum-Form"@de ;
    rdfs:comment "Validates the expected structure of an international ocean governance forum."@en ;
    sh:property compass:NameShape ;
    sh:property compass:LatShape ;
    sh:property compass:LongShape ;
    sh:property compass:LocationShape ;
    sh:property compass:WebsiteUrlShape ;
    sh:property compass:ImageShape ;
    sh:property compass:KeySentenceShape ;
    sh:property compass:ManagedByOceanCareShape ;
    sh:property compass:FoundingDateShape .

compass:NetworkShape a sh:NodeShape ;
    sh:targetClass compass:Network ;
    rdfs:label "Network Shape"@en ;
    rdfs:label "Netzwerk-Form"@de ;
    rdfs:comment "Validates the expected structure of a collaborative ocean network."@en ;
    sh:property compass:NameShape ;
    sh:property compass:LatShape ;
    sh:property compass:LongShape ;
    sh:property compass:LocationShape ;
    sh:property compass:WebsiteUrlShape ;
    sh:property compass:ImageShape ;
    sh:property compass:KeySentenceShape ;
    sh:property compass:ManagedByOceanCareShape ;
    sh:property compass:FoundingDateShape .

compass:PartnerOrganizationShape a sh:NodeShape ;
    sh:targetClass compass:PartnerOrganization ;
    rdfs:label "Partner Organization Shape"@en ;
    rdfs:label "Partnerorganisation-Form"@de ;
    rdfs:comment "Validates the expected structure of an OceanCare partner organization."@en ;
    sh:property compass:NameShape ;
    sh:property compass:LatShape ;
    sh:property compass:LongShape ;
    sh:property compass:LocationShape ;
    sh:property compass:WebsiteUrlShape ;
    sh:property compass:ImageShape ;
    sh:property compass:KeySentenceShape ;
    sh:property compass:ManagedByOceanCareShape ;
    sh:property compass:FoundingDateShape .

compass:ProjectShape a sh:NodeShape ;
    sh:targetClass compass:Project ;
    rdfs:label "Project Shape"@en ;
    rdfs:label "Projekt-Form"@de ;
    rdfs:comment "Validates the expected structure of a project or programme."@en ;
    sh:property compass:NameShape ;
    sh:property compass:LatShape ;
    sh:property compass:LongShape ;
    sh:property compass:LocationShape ;
    sh:property compass:WebsiteUrlShape ;
    sh:property compass:ImageShape ;
    sh:property compass:KeySentenceShape ;
    sh:property compass:ManagedByOceanCareShape ;
    sh:property compass:FoundingDateShape ;
    sh:property compass:StartDateShape .

# ============================================================
# SHACL Node Shape: FocusAreaShape
# ============================================================

compass:FocusAreaShape a sh:NodeShape ;
    sh:targetClass compass:FocusArea ;
    rdfs:label "Focus Area Shape"@en ;
    rdfs:label "Schwerpunktbereich-Form"@de ;
    rdfs:comment "Validates focus area concept instances."@en ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:name "preferred label"@en ;
        sh:name "bevorzugte Bezeichnung"@de ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:uniqueLang true ;
    ] .

# ============================================================
# SHACL Node Shape: ThemeShape
# ============================================================

compass:ThemeShape a sh:NodeShape ;
    sh:targetClass compass:Theme ;
    rdfs:label "Theme Shape"@en ;
    rdfs:label "Thema-Form"@de ;
    rdfs:comment "Validates theme concept instances."@en ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:name "preferred label"@en ;
        sh:name "bevorzugte Bezeichnung"@de ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:uniqueLang true ;
    ] ;

    sh:property [
        sh:path compass:isPublic ;
        sh:name "is public"@en ;
        sh:name "ist öffentlich"@de ;
        sh:description "Whether this theme is publicly visible in the Compass UI."@en ;
        sh:datatype xsd:boolean ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] .
