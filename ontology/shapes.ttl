@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ocorg: <http://example.org/ocean-org/ontology#> .

# ============================================================
# SHACL Shapes: Oceanographic Organizations
# ============================================================

# ============================================================
# Classes (plain RDFS — SHACL doesn't replace class declarations)
# ============================================================

ocorg:Organization a rdfs:Class ;
    rdfs:label "Organization"@en ;
    rdfs:label "Organisation"@de ;
    rdfs:comment "An oceanographic or marine science organization."@en ;
    rdfs:comment "Eine ozeanographische oder meereswissenschaftliche Organisation."@de .

ocorg:ResearchInstitute a rdfs:Class ;
    rdfs:subClassOf ocorg:Organization ;
    rdfs:label "Research Institute"@en ;
    rdfs:label "Forschungsinstitut"@de ;
    rdfs:comment "A dedicated research institute focused on ocean science."@en ;
    rdfs:comment "Ein spezialisiertes Forschungsinstitut mit Schwerpunkt Meeresforschung."@de .

ocorg:University a rdfs:Class ;
    rdfs:subClassOf ocorg:Organization ;
    rdfs:label "University"@en ;
    rdfs:label "Universität"@de ;
    rdfs:comment "A university with an oceanographic department or program."@en ;
    rdfs:comment "Eine Universität mit einem ozeanographischen Fachbereich oder Programm."@de .

ocorg:GovernmentAgency a rdfs:Class ;
    rdfs:subClassOf ocorg:Organization ;
    rdfs:label "Government Agency"@en ;
    rdfs:label "Regierungsbehörde"@de ;
    rdfs:comment "A government body involved in ocean research or management."@en ;
    rdfs:comment "Eine staatliche Stelle, die in der Meeresforschung oder -verwaltung tätig ist."@de .

ocorg:NGO a rdfs:Class ;
    rdfs:subClassOf ocorg:Organization ;
    rdfs:label "NGO"@en ;
    rdfs:label "NGO"@de ;
    rdfs:comment "A non-governmental organization working in marine science or conservation."@en ;
    rdfs:comment "Eine Nichtregierungsorganisation, die in der Meereswissenschaft oder im Naturschutz tätig ist."@de .

ocorg:FocusArea a rdfs:Class ;
    rdfs:label "Focus Area"@en ;
    rdfs:label "Schwerpunktbereich"@de ;
    rdfs:comment "A thematic research or activity focus area."@en ;
    rdfs:comment "Ein thematischer Forschungs- oder Tätigkeitsschwerpunkt."@de .

ocorg:Project a rdfs:Class ;
    rdfs:label "Project"@en ;
    rdfs:label "Projekt"@de ;
    rdfs:comment "A research project conducted by an organization."@en ;
    rdfs:comment "Ein Forschungsprojekt, das von einer Organisation durchgeführt wird."@de .

ocorg:Network a rdfs:Class ;
    rdfs:label "Network"@en ;
    rdfs:label "Netzwerk"@de ;
    rdfs:comment "A collaborative ocean research or monitoring network spanning multiple organizations."@en ;
    rdfs:comment "Ein kollaboratives Netzwerk für Meeresforschung oder -überwachung über mehrere Organisationen hinweg."@de .

ocorg:InternationalForum a rdfs:Class ;
    rdfs:label "International Forum"@en ;
    rdfs:label "Internationales Forum"@de ;
    rdfs:comment "An international policy, governance, or coordination forum for ocean affairs."@en ;
    rdfs:comment "Ein internationales Policy-, Governance- oder Koordinierungsforum für Meeresangelegenheiten."@de .

# ============================================================
# Shared (Named) Property Shapes
# Reused across OrganizationShape, NetworkShape, and InternationalForumShape.
# Defining constraints as named shapes enables reference by multiple node shapes
# without duplicating constraint definitions.
# ============================================================

ocorg:NamePropertyShape a sh:PropertyShape ;
    sh:path ocorg:organizationName ;
    sh:name "name"@en ;
    sh:name "Name"@de ;
    sh:description "The display name of the entity."@en ;
    sh:description "Der Anzeigename der Entität."@de ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 .

ocorg:GeoLatPropertyShape a sh:PropertyShape ;
    sh:path geo:lat ;
    sh:name "latitude"@en ;
    sh:name "Breitengrad"@de ;
    sh:description "WGS84 latitude."@en ;
    sh:description "WGS84 Breitengrad."@de ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive -90.0 ;
    sh:maxInclusive 90.0 ;
    sh:severity sh:Violation .

ocorg:GeoLongPropertyShape a sh:PropertyShape ;
    sh:path geo:long ;
    sh:name "longitude"@en ;
    sh:name "Längengrad"@de ;
    sh:description "WGS84 longitude."@en ;
    sh:description "WGS84 Längengrad."@de ;
    sh:datatype xsd:double ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive -180.0 ;
    sh:maxInclusive 180.0 ;
    sh:severity sh:Violation .

ocorg:CountryPropertyShape a sh:PropertyShape ;
    sh:path ocorg:country ;
    sh:name "country"@en ;
    sh:name "Land"@de ;
    sh:description "The country where the entity is primarily based."@en ;
    sh:description "Das Land, in dem die Entität primär ansässig ist."@de ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

ocorg:WebsitePropertyShape a sh:PropertyShape ;
    sh:path ocorg:websiteUrl ;
    sh:name "website URL"@en ;
    sh:name "Website-URL"@de ;
    sh:description "The entity's official website."@en ;
    sh:description "Die offizielle Website der Entität."@de ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 ;
    sh:severity sh:Warning .

ocorg:KeySentencePropertyShape a sh:PropertyShape ;
    sh:path ocorg:keySentence ;
    sh:name "key sentence"@en ;
    sh:name "Kernsatz"@de ;
    sh:description "A single sentence summarizing the entity."@en ;
    sh:description "Ein einzelner Satz, der die Entität zusammenfasst."@de ;
    sh:datatype xsd:string ;
    sh:maxCount 1 .

ocorg:FocusAreaPropertyShape a sh:PropertyShape ;
    sh:path ocorg:hasFocusArea ;
    sh:name "has focus area"@en ;
    sh:name "hat Schwerpunktbereich"@de ;
    sh:description "Links to one or more research or activity focus areas."@en ;
    sh:description "Verknüpft mit einem oder mehreren Forschungs- oder Aktivitätsschwerpunkten."@de ;
    sh:class ocorg:FocusArea ;
    sh:nodeKind sh:IRI .

ocorg:OceanRegionPropertyShape a sh:PropertyShape ;
    sh:path ocorg:primaryOceanRegion ;
    sh:name "primary ocean region"@en ;
    sh:name "primäre Meeresregion"@de ;
    sh:description "The primary ocean basin or region the entity focuses on."@en ;
    sh:description "Das primäre Meeresbecken oder die Region, auf die sich die Entität konzentriert."@de ;
    sh:nodeKind sh:IRI ;
    sh:in ( ocorg:Region_Atlantic ocorg:Region_Pacific ocorg:Region_Indian ocorg:Region_Arctic ocorg:Region_Southern ocorg:Region_Global ) ;
    sh:maxCount 1 .

ocorg:FundingSourcePropertyShape a sh:PropertyShape ;
    sh:path ocorg:fundingSource ;
    sh:name "funding source"@en ;
    sh:name "Finanzierungsquelle"@de ;
    sh:description "Primary source of funding."@en ;
    sh:description "Hauptquelle der Finanzierung."@de ;
    sh:nodeKind sh:IRI ;
    sh:in ( ocorg:Funding_Public ocorg:Funding_Private ocorg:Funding_Mixed ocorg:Funding_International ) ;
    sh:maxCount 1 .

ocorg:MostRecentUpdatePropertyShape a sh:PropertyShape ;
    sh:path ocorg:mostRecentUpdate ;
    sh:name "most recent update"@en ;
    sh:name "letzte Aktualisierung"@de ;
    sh:description "Date of the most recent information update."@en ;
    sh:description "Datum der letzten Informationsaktualisierung."@de ;
    sh:datatype xsd:date ;
    sh:maxCount 1 .

ocorg:ActivitiesPropertyShape a sh:PropertyShape ;
    sh:path ocorg:activities ;
    sh:name "activities"@en ;
    sh:name "Aktivitäten"@de ;
    sh:description "Key activities, initiatives, or research efforts."@en ;
    sh:description "Wesentliche Aktivitäten, Initiativen oder Forschungsbemühungen."@de ;
    sh:datatype xsd:string .

ocorg:FoundedYearPropertyShape a sh:PropertyShape ;
    sh:path ocorg:foundedYear ;
    sh:name "founded year"@en ;
    sh:name "Gründungsjahr"@de ;
    sh:description "The year the entity was established."@en ;
    sh:description "Das Jahr, in dem die Entität gegründet wurde."@de ;
    sh:datatype xsd:gYear ;
    sh:maxCount 1 .

# ============================================================
# SHACL Node Shape: OrganizationShape
# ============================================================

ocorg:OrganizationShape a sh:NodeShape ;
    sh:targetClass ocorg:Organization ;
    rdfs:label "Organization Shape"@en ;
    rdfs:label "Organisations-Form"@de ;
    rdfs:comment "Validates the expected structure of an oceanographic organization."@en ;
    rdfs:comment "Validiert die erwartete Struktur einer ozeanographischen Organisation."@de ;

    # --- organizationName (required, exactly 1, string) ---
    sh:property [
        sh:path ocorg:organizationName ;
        sh:name "organization name"@en ;
        sh:name "Organisationsname"@de ;
        sh:description "The display name of the organization."@en ;
        sh:description "Der Anzeigename der Organisation."@de ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # --- country (required, exactly 1, string) ---
    sh:property [
        sh:path ocorg:country ;
        sh:name "country"@en ;
        sh:name "Land"@de ;
        sh:description "The country where the organization is located."@en ;
        sh:description "Das Land, in dem sich die Organisation befindet."@de ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;

    # --- foundedYear (optional, at most 1, gYear) ---
    sh:property [
        sh:path ocorg:foundedYear ;
        sh:name "founded year"@en ;
        sh:name "Gründungsjahr"@de ;
        sh:description "The year the organization was established."@en ;
        sh:description "Das Jahr, in dem die Organisation gegründet wurde."@de ;
        sh:datatype xsd:gYear ;
        sh:maxCount 1 ;
    ] ;

    # --- staffSize (optional, at most 1, integer, ≥ 1) ---
    sh:property [
        sh:path ocorg:staffSize ;
        sh:name "staff size"@en ;
        sh:name "Personalstärke"@de ;
        sh:description "Approximate number of staff or researchers."@en ;
        sh:description "Ungefähre Anzahl der Mitarbeiter oder Forscher."@de ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
    ] ;

    # --- websiteUrl (optional, at most 1, anyURI) ---
    sh:property [
        sh:path ocorg:websiteUrl ;
        sh:name "website URL"@en ;
        sh:name "Website-URL"@de ;
        sh:description "The organization's website."@en ;
        sh:description "Die Website der Organisation."@de ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
    ] ;

    # --- hasFocusArea (at least 1, must be a FocusArea instance) ---
    sh:property [
        sh:path ocorg:hasFocusArea ;
        sh:name "has focus area"@en ;
        sh:name "hat Schwerpunktbereich"@de ;
        sh:description "Links an organization to one or more research focus areas."@en ;
        sh:description "Verknüpft eine Organisation mit einem oder mehreren Forschungsschwerpunkten."@de ;
        sh:class ocorg:FocusArea ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
    ] ;

    # --- geo:lat (required, exactly 1, double, -90..90) ---
    sh:property [
        sh:path geo:lat ;
        sh:name "latitude"@en ;
        sh:name "Breitengrad"@de ;
        sh:description "WGS84 latitude."@en ;
        sh:description "WGS84 Breitengrad."@de ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive -90.0 ;
        sh:maxInclusive 90.0 ;
        sh:severity sh:Violation ;
    ] ;

    # --- geo:long (required, exactly 1, double, -180..180) ---
    sh:property [
        sh:path geo:long ;
        sh:name "longitude"@en ;
        sh:name "Längengrad"@de ;
        sh:description "WGS84 longitude."@en ;
        sh:description "WGS84 Längengrad."@de ;
        sh:datatype xsd:double ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:minInclusive -180.0 ;
        sh:maxInclusive 180.0 ;
        sh:severity sh:Violation ;
    ] ;

    # --- annualBudgetUSD (optional, integer, millions USD) ---
    sh:property [
        sh:path ocorg:annualBudgetUSD ;
        sh:name "annual budget (USD millions)"@en ;
        sh:name "jährliches Budget (USD Millionen)"@de ;
        sh:description "Approximate annual research budget in millions of US dollars."@en ;
        sh:description "Ungefähres jährliches Forschungsbudget in Millionen US-Dollar."@de ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;

    # --- publicationsPerYear (optional, integer) ---
    sh:property [
        sh:path ocorg:publicationsPerYear ;
        sh:name "publications per year"@en ;
        sh:name "Publikationen pro Jahr"@de ;
        sh:description "Approximate number of peer-reviewed publications per year."@en ;
        sh:description "Ungefähre Anzahl der Peer-Review-Publikationen pro Jahr."@de ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;

    # --- researchVessels (optional, integer) ---
    sh:property [
        sh:path ocorg:researchVessels ;
        sh:name "research vessels"@en ;
        sh:name "Forschungsschiffe"@de ;
        sh:description "Number of research vessels operated."@en ;
        sh:description "Anzahl der betriebenen Forschungsschiffe."@de ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 0 ;
    ] ;

    # --- accessType (optional, controlled vocab IRI) ---
    sh:property [
        sh:path ocorg:accessType ;
        sh:name "access type"@en ;
        sh:name "Zugangstyp"@de ;
        sh:description "How external researchers can access this organization's facilities or data."@en ;
        sh:description "Wie externe Forscher auf die Einrichtungen oder Daten dieser Organisation zugreifen können."@de ;
        sh:nodeKind sh:IRI ;
        sh:in ( ocorg:Access_Open ocorg:Access_Restricted ocorg:Access_ByPartnership ) ;
        sh:maxCount 1 ;
    ] ;

    # --- fundingSource (optional, controlled vocab IRI) ---
    sh:property [
        sh:path ocorg:fundingSource ;
        sh:name "funding source"@en ;
        sh:name "Finanzierungsquelle"@de ;
        sh:description "Primary source of organizational funding."@en ;
        sh:description "Hauptquelle der Organisationsfinanzierung."@de ;
        sh:nodeKind sh:IRI ;
        sh:in ( ocorg:Funding_Public ocorg:Funding_Private ocorg:Funding_Mixed ocorg:Funding_International ) ;
        sh:maxCount 1 ;
    ] ;

    # --- primaryOceanRegion (optional, controlled vocab IRI) ---
    sh:property [
        sh:path ocorg:primaryOceanRegion ;
        sh:name "primary ocean region"@en ;
        sh:name "primäre Meeresregion"@de ;
        sh:description "The primary ocean basin or region the organization focuses on."@en ;
        sh:description "Das primäre Meeresbecken oder die Region, auf die sich die Organisation konzentriert."@de ;
        sh:nodeKind sh:IRI ;
        sh:in ( ocorg:Region_Atlantic ocorg:Region_Pacific ocorg:Region_Indian ocorg:Region_Arctic ocorg:Region_Southern ocorg:Region_Global ) ;
        sh:maxCount 1 ;
    ] ;

    # --- keySentence (optional, at most 1, string) ---
    sh:property [
        sh:path ocorg:keySentence ;
        sh:name "key sentence"@en ;
        sh:name "Kernsatz"@de ;
        sh:description "A single sentence summarizing the organization."@en ;
        sh:description "Ein einzelner Satz, der die Organisation zusammenfasst."@de ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    # --- activities (optional, multi-value, string) ---
    sh:property [
        sh:path ocorg:activities ;
        sh:name "activities"@en ;
        sh:name "Aktivitäten"@de ;
        sh:description "Key activities or research efforts the organization undertakes."@en ;
        sh:description "Wesentliche Aktivitäten oder Forschungsbemühungen der Organisation."@de ;
        sh:datatype xsd:string ;
    ] ;

    # --- mostRecentUpdate (optional, at most 1, date) ---
    sh:property [
        sh:path ocorg:mostRecentUpdate ;
        sh:name "most recent update"@en ;
        sh:name "letzte Aktualisierung"@de ;
        sh:description "Date of the most recent information update for this organization."@en ;
        sh:description "Datum der letzten Informationsaktualisierung für diese Organisation."@de ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
    ] ;

    # --- donationUrl (optional, at most 1, anyURI) ---
    sh:property [
        sh:path ocorg:donationUrl ;
        sh:name "donation URL"@en ;
        sh:name "Spenden-URL"@de ;
        sh:description "URL where donations can be made to support the organization."@en ;
        sh:description "URL, unter der Spenden für die Organisation getätigt werden können."@de ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;

    # --- offersResearchTrips (optional, at most 1, boolean) ---
    sh:property [
        sh:path ocorg:offersResearchTrips ;
        sh:name "offers research trips"@en ;
        sh:name "bietet Forschungsreisen an"@de ;
        sh:description "Whether the organization offers research trips to the public or students."@en ;
        sh:description "Ob die Organisation Forschungsreisen für die Öffentlichkeit oder Studierende anbietet."@de ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
    ] ;

    # --- hasProject (optional, links to Project instances) ---
    sh:property [
        sh:path ocorg:hasProject ;
        sh:name "has project"@en ;
        sh:name "hat Projekt"@de ;
        sh:description "Links to research projects run by this organization."@en ;
        sh:description "Verknüpfung mit Forschungsprojekten dieser Organisation."@de ;
        sh:class ocorg:Project ;
        sh:nodeKind sh:IRI ;
    ] .

# ============================================================
# SHACL Node Shapes: Organization Subclasses
# Each delegates property validation to OrganizationShape via sh:node.
# Keeping subclasses as separate shapes avoids infinite recursion in
# tools (e.g. SHACL Play) that follow sh:targetClass hierarchies.
# ============================================================

ocorg:ResearchInstituteShape a sh:NodeShape ;
    sh:targetClass ocorg:ResearchInstitute ;
    rdfs:label "Research Institute Shape"@en ;
    rdfs:label "Forschungsinstitut-Form"@de ;
    sh:node ocorg:OrganizationShape .

ocorg:UniversityShape a sh:NodeShape ;
    sh:targetClass ocorg:University ;
    rdfs:label "University Shape"@en ;
    rdfs:label "Universitäts-Form"@de ;
    sh:node ocorg:OrganizationShape .

ocorg:GovernmentAgencyShape a sh:NodeShape ;
    sh:targetClass ocorg:GovernmentAgency ;
    rdfs:label "Government Agency Shape"@en ;
    rdfs:label "Regierungsbehörden-Form"@de ;
    sh:node ocorg:OrganizationShape .

ocorg:NGOShape a sh:NodeShape ;
    sh:targetClass ocorg:NGO ;
    rdfs:label "NGO Shape"@en ;
    rdfs:label "NGO-Form"@de ;
    sh:node ocorg:OrganizationShape .

# ============================================================
# SHACL Node Shape: NetworkShape
# Reuses shared property shapes; adds network-specific constraints.
# ============================================================

ocorg:NetworkShape a sh:NodeShape ;
    sh:targetClass ocorg:Network ;
    rdfs:label "Network Shape"@en ;
    rdfs:label "Netzwerk-Form"@de ;
    rdfs:comment "Validates the expected structure of a collaborative ocean research or monitoring network."@en ;
    rdfs:comment "Validiert die erwartete Struktur eines kollaborativen Meeresforschungs- oder Überwachungsnetzwerks."@de ;

    # Shared property shapes (reused with OrganizationShape and InternationalForumShape)
    sh:property ocorg:NamePropertyShape ;
    sh:property ocorg:GeoLatPropertyShape ;
    sh:property ocorg:GeoLongPropertyShape ;
    sh:property ocorg:CountryPropertyShape ;
    sh:property ocorg:WebsitePropertyShape ;
    sh:property ocorg:KeySentencePropertyShape ;
    sh:property ocorg:FocusAreaPropertyShape ;
    sh:property ocorg:OceanRegionPropertyShape ;
    sh:property ocorg:FundingSourcePropertyShape ;
    sh:property ocorg:MostRecentUpdatePropertyShape ;
    sh:property ocorg:ActivitiesPropertyShape ;
    sh:property ocorg:FoundedYearPropertyShape ;

    # --- memberCount (optional, integer, ≥ 1) ---
    sh:property [
        sh:path ocorg:memberCount ;
        sh:name "member count"@en ;
        sh:name "Mitgliederanzahl"@de ;
        sh:description "Number of member organizations or institutions in the network."@en ;
        sh:description "Anzahl der Mitgliedsorganisationen oder -institutionen im Netzwerk."@de ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
    ] ;

    # --- hasLeadOrganization (optional, link to an Organization IRI) ---
    sh:property [
        sh:path ocorg:hasLeadOrganization ;
        sh:name "lead organization"@en ;
        sh:name "Leitorganisation"@de ;
        sh:description "The organization leading or hosting the network secretariat."@en ;
        sh:description "Die Organisation, die das Netzwerksekretariat leitet oder beherbergt."@de ;
        sh:class ocorg:Organization ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .

# ============================================================
# SHACL Node Shape: InternationalForumShape
# Reuses shared property shapes; adds forum-specific constraints.
# ============================================================

ocorg:InternationalForumShape a sh:NodeShape ;
    sh:targetClass ocorg:InternationalForum ;
    rdfs:label "International Forum Shape"@en ;
    rdfs:label "Internationales Forum-Form"@de ;
    rdfs:comment "Validates the expected structure of an international ocean governance forum."@en ;
    rdfs:comment "Validiert die erwartete Struktur eines internationalen Meeresgovernance-Forums."@de ;

    # Shared property shapes (reused with OrganizationShape and NetworkShape)
    sh:property ocorg:NamePropertyShape ;
    sh:property ocorg:GeoLatPropertyShape ;
    sh:property ocorg:GeoLongPropertyShape ;
    sh:property ocorg:CountryPropertyShape ;
    sh:property ocorg:WebsitePropertyShape ;
    sh:property ocorg:KeySentencePropertyShape ;
    sh:property ocorg:FocusAreaPropertyShape ;
    sh:property ocorg:OceanRegionPropertyShape ;
    sh:property ocorg:FundingSourcePropertyShape ;
    sh:property ocorg:MostRecentUpdatePropertyShape ;
    sh:property ocorg:ActivitiesPropertyShape ;
    sh:property ocorg:FoundedYearPropertyShape ;

    # --- memberStates (optional, integer) ---
    sh:property [
        sh:path ocorg:memberStates ;
        sh:name "member states"@en ;
        sh:name "Mitgliedstaaten"@de ;
        sh:description "Number of member nation-states participating in the forum."@en ;
        sh:description "Anzahl der am Forum teilnehmenden Mitglied-Nationalstaaten."@de ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
        sh:minInclusive 1 ;
    ] ;

    # --- mandate (optional, at most 1, string) ---
    sh:property [
        sh:path ocorg:mandate ;
        sh:name "mandate"@en ;
        sh:name "Mandat"@de ;
        sh:description "The official mandate or mission statement of the forum."@en ;
        sh:description "Das offizielle Mandat oder die Leitbild-Erklärung des Forums."@de ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] ;

    # --- hostCountry (optional, at most 1, string) ---
    sh:property [
        sh:path ocorg:hostCountry ;
        sh:name "host country"@en ;
        sh:name "Gastland"@de ;
        sh:description "The country hosting the forum's secretariat."@en ;
        sh:description "Das Land, das das Sekretariat des Forums beherbergt."@de ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
    ] .

# ============================================================
# SHACL Node Shape: FocusAreaShape
# ============================================================

ocorg:FocusAreaShape a sh:NodeShape ;
    sh:targetClass ocorg:FocusArea ;
    rdfs:label "Focus Area Shape"@en ;
    rdfs:label "Schwerpunktbereich-Form"@de ;
    rdfs:comment "Validates focus area instances."@en ;
    rdfs:comment "Validiert Schwerpunktbereich-Instanzen."@de ;

    sh:property [
        sh:path rdfs:label ;
        sh:name "label"@en ;
        sh:name "Bezeichnung"@de ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:uniqueLang true ;
    ] ;

    sh:property [
        sh:path skos:prefLabel ;
        sh:name "preferred label"@en ;
        sh:name "bevorzugte Bezeichnung"@de ;
        sh:datatype rdf:langString ;
        sh:uniqueLang true ;
    ] .

# ============================================================
# Focus Area Instances (controlled vocabulary)
# ============================================================

ocorg:MarineBiology a ocorg:FocusArea ;
