# ============================================================
# SHACL Node Shape: ProjectShape
# ============================================================

compass:ProjectShape a sh:NodeShape ;
    sh:targetClass compass:Project ;
    rdfs:label "Project Shape"@en ;
    rdfs:label "Projekt-Form"@de ;
    rdfs:comment "Validates the expected structure of a research project."@en ;
    rdfs:comment "Validiert die erwartete Struktur eines Forschungsprojekts."@de ;

    sh:property [
        sh:path compass:projectName ;
        sh:name "project name"@en ;
        sh:name "Projektname"@de ;
        sh:description "The name of the research project."@en ;
        sh:description "Der Name des Forschungsprojekts."@de ;
        sh:datatype rdf:langString ;
        sh:minCount 1 ;
        sh:uniqueLang true ;
    ] ;

    sh:property [
        sh:path compass:startDate ;
        sh:name "start date"@en ;
        sh:name "Startdatum"@de ;
        sh:description "The start date of the project."@en ;
        sh:description "Das Startdatum des Projekts."@de ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path compass:endDate ;
        sh:name "end date"@en ;
        sh:name "Enddatum"@de ;
        sh:description "The end date of the project."@en ;
        sh:description "Das Enddatum des Projekts."@de ;
        sh:datatype xsd:date ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path compass:species ;
        sh:name "species"@en ;
        sh:name "Arten"@de ;
        sh:description "Species studied in the project."@en ;
        sh:description "Im Projekt untersuchte Arten."@de ;
        sh:class skos:Concept ;
        sh:nodeKind sh:IRI ;
    ] ;

    sh:property [
        sh:path compass:imageUrl ;
        sh:name "image URL"@en ;
        sh:name "Bild-URL"@de ;
        sh:description "URL of an image representing the project."@en ;
        sh:description "URL eines Bildes, das das Projekt darstellt."@de ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] ;

    sh:property [
        sh:path compass:projectUrl ;
        sh:name "project URL"@en ;
        sh:name "Projekt-URL"@de ;
        sh:description "URL of the project's web page."@en ;
        sh:description "URL der Projektwebseite."@de ;
        sh:datatype xsd:anyURI ;
        sh:maxCount 1 ;
    ] .