@prefix rdf:    <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix geo:    <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix schema: <https://schema.org/> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .
@prefix compass: <http://example.org/ocean-org/ontology#> .
@prefix ocinst:  <http://example.org/ocean-org/data#> .

# ============================================================
# Property Declarations
# ============================================================

compass:wpTagId a rdf:Property ;
    rdfs:label "WordPress Tag ID"@en ;
    rdfs:comment "Numeric term ID of the corresponding SKOS concept tag on the OceanCare website."@en ;
    rdfs:range xsd:integer .

compass:isoCode a rdf:Property ;
    rdfs:label "ISO / boundary code"@en ;
    rdfs:comment "Boundary lookup key for a Country/Area concept (ISO 3166-1 alpha-3, or a custom code for sub-national/marine areas). Used by the frontend region-boundary build script; not sent to the map (regions are keyed by concept local name)."@en ;
    rdfs:range xsd:string .

compass:wpEntityTagIdEn a rdf:Property ;
    rdfs:label "WordPress Entity Tag ID (English)"@en ;
    rdfs:comment "Numeric WP term ID of the English per-entity tag on OceanCare (used to link to English stories about this entity)."@en ;
    rdfs:range xsd:integer .

compass:wpEntityTagIdDe a rdf:Property ;
    rdfs:label "WordPress Entity Tag ID (German)"@en ;
    rdfs:comment "Numeric WP term ID of the German per-entity tag on OceanCare (used to link to German stories about this entity)."@en ;
    rdfs:range xsd:integer .

