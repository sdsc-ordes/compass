    compass:name "Morigenos"@en ;
    compass:name "Morigenos"@de ;
    rdfs:label "Morigenos"@en ;
    rdfs:label "Morigenos"@de ;
    compass:location "Piran, Slovenia"@en ;
    compass:description "In Slovenia, OceanCare has supported the Morigenos Dolphin Centre since 2020. It serves as a field station for research projects on the protection of bottlenose dolphins in the Gulf of Trieste, where fishing poses a particular threat."@en ;
    compass:description "In Slowenien unterstützt OceanCare das Delfinzentrum von Morigenos seit 2020. Es dient als Feldstation für Forschungsprojekte zum Schutz der Grossen Tümmler im Golf von Triest, wo insbesondere die Fischerei eine Bedrohung darstellt."@de ;
    compass:managedByOceanCare false ;
