    compass:topic compass:Fisheries ;
    compass:pollution compass:PlasticPollution ;
    compass:species compass:Fish, compass:SeaTurtles ;
    compass:countryArea compass:Spain, compass:WesternMediterraneanSea ;
    geo:lat "39.76636"^^xsd:float ;
    geo:long "2.71522"^^xsd:float .

ocinst:BEES
    a compass:PartnerOrganization ;
    compass:name "BEES"@en ;
    compass:name "BEES"@de ;
    rdfs:label "BEES"@en ;
    rdfs:label "BEES"@de ;
    skos:altLabel "Benin Environment and Education Society"@en ;
    compass:location "Porto Novo, Benin"@en ;
    compass:description "Declining fish species and harmful fishing practices threaten marine ecosystems and coastal livelihoods, while scarcity is driving the hunting of protected species such as dolphins, manatees, sharks, and rays for aquatic wild meat. OceanCare has been working with Benin Environment and Education Society (BEES) to promote sustainable solutions in the Gulf of Guinea since 2018."@en ;
    compass:description "Rückläufige Fischbestände und zerstörerische Fischereipraktiken bedrohen Meeresökosysteme und die Lebensgrundlagen der Küstengemeinschaften. Gleichzeitig führt die zunehmende Knappheit dazu, dass geschützte Arten wie Delfine, Seekühe, Haie und Rochen als sogenanntes Aquatic Wild Meat gejagt werden. Gemeinsam mit der Benin Environment and Education Society (BEES) setzt sich OceanCare im Golf von Guinea seit 2018 für nachhaltige Lösungen ein."@de ;
    schema:foundingDate "2019"^^xsd:gYear ;
    compass:managedByOceanCare false ;
    compass:workArea compass:ScientificResearch ;
    compass:conservation compass:AnimalAndSpeciesConservation ;
    compass:topic compass:AquaticWildMeat, compass:Hunting ;
