ocinst:UNEPUNEA
    a compass:InternationalForum ;
    compass:name "UNEP/UNEA"@en ;
    compass:name "UNEP/UNEA"@de ;
    rdfs:label "UNEP/UNEA"@en ;
    rdfs:label "UNEP/UNEA"@de ;
