@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix geo:  <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix compass: <http://example.org/ocean-org/ontology#> .
@prefix schema: <https://schema.org/> .

# ============================================================
# SHACL Shapes: OceanCare Compass Entities
# ============================================================

# ============================================================
# Entity Classes (4 types appearing on the map)
# ============================================================

compass:MapEntity a rdfs:Class ;
    rdfs:label "Map Entity"@en ;
    rdfs:label "Karteneintrag"@de ;
    rdfs:comment "A class whose instances are drawn on the map. Only NodeShapes targeting a subclass of this are projected into filter widgets and the SPARQL entity query; every other shape in this file is validation-only."@en .

compass:InternationalForum a rdfs:Class ;
    rdfs:subClassOf compass:MapEntity ;
    rdfs:label "International Forum"@en ;
    rdfs:label "Internationales Forum"@de ;
    rdfs:comment "An international policy, governance, or coordination forum for ocean affairs."@en ;
    rdfs:comment "Ein internationales Policy-, Governance- oder Koordinierungsforum für Meeresangelegenheiten."@de .

compass:Network a rdfs:Class ;
    rdfs:subClassOf compass:MapEntity ;
    rdfs:label "Network"@en ;
    rdfs:label "Netzwerk"@de ;
    rdfs:comment "A collaborative ocean research or monitoring network spanning multiple organizations."@en ;
    rdfs:comment "Ein kollaboratives Netzwerk für Meeresforschung oder -überwachung über mehrere Organisationen hinweg."@de .

compass:HostOrganization a rdfs:Class ;
    rdfs:subClassOf compass:MapEntity ;
    rdfs:label "OceanCare"@en ;
    rdfs:label "OceanCare"@de ;
    rdfs:comment "The organization whose map this is. Drawn whatever the filters say, and absent from the entity-type filter: it is the map's subject rather than one of its results."@en ;
    rdfs:comment "Die Organisation, deren Karte dies ist. Wird unabhängig von den Filtern gezeichnet und erscheint nicht im Filter nach Eintragsart: Sie ist das Thema der Karte, nicht eines ihrer Ergebnisse."@de .

compass:PartnerOrganization a rdfs:Class ;
    rdfs:subClassOf compass:MapEntity ;
    rdfs:label "Partner Organization"@en ;
    rdfs:label "Partnerorganisation"@de ;
    rdfs:comment "An OceanCare partner organization active in marine conservation or research."@en ;
    rdfs:comment "Eine OceanCare-Partnerorganisation, die im Meeresschutz oder in der Meeresforschung tätig ist."@de .

# ============================================================
# Tag Dimension Classes (5 SKOS-based tag vocabularies)
# ============================================================

compass:WorkArea a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Work Areas"@en ;
    rdfs:label "Arbeitsbereiche"@de ;
    rdfs:comment "A type of work OceanCare performs."@en .

compass:Topic a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Topics"@en ;
    rdfs:label "Themen"@de ;
    rdfs:comment "A thematic topic OceanCare addresses, or an activity it runs."@en .

compass:Programme a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Programmes"@en ;
    rdfs:label "Programme"@de ;
    rdfs:comment "A programme or project OceanCare runs. A thing it does rather than a place on the map, so it tags pins instead of being one."@en .

compass:Species a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Species"@en ;
    rdfs:label "Arten"@de ;
    rdfs:comment "A marine or aquatic species relevant to OceanCare's work."@en .

compass:CountryArea a rdfs:Class ;
    rdfs:subClassOf skos:Concept ;
    rdfs:label "Countries / Regions"@en ;
    rdfs:label "Länder / Regionen"@de ;
    rdfs:comment "A country or geographic region relevant to OceanCare's work."@en .

# ============================================================
# Property Declarations
# All properties used as sh:path values must be typed as rdf:Property
# with rdfs:label and rdfs:comment to satisfy ordes:pathShape and
# ordes:conceptShape in shacl-shacl.ttl.
# ============================================================

# -- Core entity properties --

compass:name a rdf:Property ;
    rdfs:label "name"@en ;
    rdfs:label "Name"@de ;
    rdfs:comment "The display name of the entity."@en .

compass:location a rdf:Property ;
    rdfs:label "location"@en ;
    rdfs:label "Ort"@de ;
    rdfs:comment "Human-readable location description (city, country)."@en .

compass:description a rdf:Property ;
    rdfs:label "description"@en ;
    rdfs:label "Beschreibung"@de ;
    rdfs:comment "A paragraph describing the entity and OceanCare's involvement with it."@en .

compass:managedByOceanCare a rdf:Property ;
    rdfs:label "managed by OceanCare"@en ;
    rdfs:label "verwaltet von OceanCare"@de ;
    rdfs:comment "Whether this entity is directly managed by OceanCare."@en .

# -- Tag dimension properties --

compass:workArea a rdf:Property ;
    rdfs:label "work area"@en ;
    rdfs:label "Arbeitsbereich"@de ;
    rdfs:comment "The type of work performed in relation to this entity."@en .

compass:topic a rdf:Property ;
    rdfs:label "topic"@en ;
    rdfs:label "Thema"@de ;
    rdfs:comment "A thematic topic associated with this entity."@en .

compass:species a rdf:Property ;
    rdfs:label "species"@en ;
    rdfs:label "Arten"@de ;
    rdfs:comment "A species associated with this entity."@en .

compass:countryArea a rdf:Property ;
    rdfs:label "country / region"@en ;
    rdfs:label "Land / Region"@de ;
    rdfs:comment "A country or geographic region associated with this entity."@en .

compass:forum a rdf:Property ;
    rdfs:label "forum"@en ;
    rdfs:label "Forum"@de ;
    rdfs:comment "An international forum associated with this entity."@en .

compass:relatedOrganization a rdf:Property ;
    rdfs:label "related organization"@en ;
    rdfs:label "Verwandte Organisation"@de ;
    rdfs:comment "A partner organization or network associated with this entity."@en .

compass:programme a rdf:Property ;
    rdfs:label "programme"@en ;
    rdfs:label "Programm"@de ;
    rdfs:comment "A programme this entity takes part in."@en .

# -- Bookkeeping properties (not filter dimensions) --

compass:wpTagId a rdf:Property ;
    rdfs:label "WordPress Tag ID"@en ;
    rdfs:comment "Numeric term ID of the corresponding SKOS concept tag on the OceanCare website."@en ;
    rdfs:range xsd:integer .

compass:wpEntityTagId a rdf:Property ;
    rdfs:label "WordPress Entity Tag ID"@en ;
    rdfs:comment "Numeric WP term ID of the per-entity tag on OceanCare, used to link to stories about this entity. One term serves both language sites, which differ only in the URL the link is built on."@en ;
    rdfs:range xsd:integer .

compass:isoCode a rdf:Property ;
    rdfs:label "ISO / boundary code"@en ;
    rdfs:comment "Boundary lookup key for a Country/Area concept: an ISO 3166-1 alpha-3 code, or several separated by spaces for a region dissolved from its members. Read by the frontend region-boundary build script; not sent to the map (regions are keyed by concept local name)."@en ;
    rdfs:range xsd:string .

# -- External properties (stub declarations) --

rdfs:label a rdf:Property ;
    rdfs:label "label"@en ;
    rdfs:comment "Human-readable name of a resource, used where a tag value is rendered from its IRI."@en .

geo:lat a rdf:Property ;
    rdfs:label "latitude"@en ;
    rdfs:comment "WGS84 latitude coordinate of a spatial thing."@en .

geo:long a rdf:Property ;
    rdfs:label "longitude"@en ;
    rdfs:comment "WGS84 longitude coordinate of a spatial thing."@en .

schema:url a rdf:Property ;
    rdfs:label "url"@en ;
    rdfs:comment "URL of the item."@en .

schema:image a rdf:Property ;
    rdfs:label "image"@en ;
    rdfs:comment "URL of an image or logo representing the entity."@en .

skos:prefLabel a rdf:Property ;
    rdfs:label "preferred label"@en ;
    rdfs:comment "The preferred lexical label for a resource, in a given language."@en .

skos:altLabel a rdf:Property ;
    rdfs:label "alternative label"@en ;
    rdfs:comment "An alternative lexical label — for an entity, the long form of an abbreviated name."@en .

# ============================================================
# Named Property Shapes (shared across entity NodeShapes)
# ============================================================

# -- Core property shapes --

compass:NameShape a sh:Shape ;
    sh:path compass:name ;
    sh:name "name"@en ;
    sh:name "Name"@de ;
    sh:description "The display name of the entity."@en ;
    sh:description "Der Anzeigename der Entität."@de ;
    sh:datatype rdf:langString ;
    sh:minCount 1 ;
    sh:uniqueLang true .

compass:LatShape a sh:Shape ;
    sh:path geo:lat ;
    sh:name "latitude"@en ;
    sh:name "Breitengrad"@de ;
    sh:description "WGS84 latitude."@en ;
    sh:datatype xsd:float ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive -90.0 ;
    sh:maxInclusive 90.0 ;
    sh:severity sh:Violation .

compass:LongShape a sh:Shape ;
    sh:path geo:long ;
    sh:name "longitude"@en ;
    sh:name "Längengrad"@de ;
    sh:description "WGS84 longitude."@en ;
    sh:datatype xsd:float ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:minInclusive -180.0 ;
    sh:maxInclusive 180.0 ;
    sh:severity sh:Violation .

compass:LocationShape a sh:Shape ;
    sh:path compass:location ;
    sh:name "location"@en ;
    sh:name "Ort"@de ;
    sh:description "Human-readable location (city, country)."@en ;
    sh:description "Menschenlesbare Ortsangabe (Stadt, Land)."@de ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true .

compass:WebsiteUrlShape a sh:Shape ;
    sh:path schema:url ;
    sh:name "website URL"@en ;
    sh:name "Website-URL"@de ;
    sh:description "The entity's official website."@en ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 ;
    sh:severity sh:Warning .

compass:ImageShape a sh:Shape ;
    sh:path schema:image ;
    sh:name "logo"@en ;
    sh:name "Logo"@de ;
    sh:description "URL of an image or logo for the entity."@en ;
    sh:datatype xsd:anyURI ;
    sh:maxCount 1 .

compass:AltLabelShape a sh:Shape ;
    sh:path skos:altLabel ;
    sh:name "long name"@en ;
    sh:name "Langform"@de ;
    sh:description "The unabbreviated name. Where it differs from the display name, the detail panel leads with it and brackets the display name after it."@en ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true .

compass:DescriptionShape a sh:Shape ;
    sh:path compass:description ;
    sh:name "description"@en ;
    sh:name "Beschreibung"@de ;
    sh:description "A paragraph describing the entity and OceanCare's involvement with it."@en ;
    sh:description "Ein Absatz, der die Entität und das Engagement von OceanCare beschreibt."@de ;
    sh:datatype rdf:langString ;
    sh:uniqueLang true .

compass:WpEntityTagIdShape a sh:Shape ;
    sh:path compass:wpEntityTagId ;
    sh:name "WordPress entity tag ID"@en ;
    sh:name "WordPress-Eintrags-Tag-ID"@de ;
    sh:description "Term ID the entity's stories are listed under on the OceanCare site."@en ;
    sh:datatype xsd:integer ;
    sh:maxCount 1 .

compass:ManagedByOceanCareShape a sh:Shape ;
    sh:path compass:managedByOceanCare ;
    sh:name "Managed by OceanCare"@en ;
    sh:name "Verwaltet von OceanCare"@de ;
    sh:description "Whether this entity is directly managed by OceanCare."@en ;
    sh:datatype xsd:boolean ;
    sh:maxCount 1 .

# -- Tag dimension property shapes --

compass:WorkAreaPropertyShape a sh:Shape ;
    sh:path compass:workArea ;
    sh:name "Work Areas"@en ;
    sh:name "Arbeitsbereiche"@de ;
    sh:description "The type of work performed."@en ;
    sh:class compass:WorkArea .

compass:TopicPropertyShape a sh:Shape ;
    sh:path compass:topic ;
    sh:name "Topics"@en ;
    sh:name "Themen"@de ;
    sh:description "A thematic topic."@en ;
    sh:class compass:Topic .

compass:SpeciesPropertyShape a sh:Shape ;
    sh:path compass:species ;
    sh:name "Species"@en ;
    sh:name "Arten"@de ;
    sh:description "A marine or aquatic species."@en ;
    sh:class compass:Species .

compass:CountryAreaPropertyShape a sh:Shape ;
    sh:path compass:countryArea ;
    sh:name "Countries / Regions"@en ;
    sh:name "Länder / Regionen"@de ;
    sh:description "A country or geographic region."@en ;
    sh:class compass:CountryArea .

compass:ForumPropertyShape a sh:Shape ;
    sh:path compass:forum ;
    sh:name "International Fora"@en ;
    sh:name "Internationale Foren"@de ;
    sh:description "An international forum."@en ;
    sh:class compass:InternationalForum .

compass:ProgrammePropertyShape a sh:Shape ;
    sh:path compass:programme ;
    sh:name "Programmes"@en ;
    sh:name "Programme"@de ;
    sh:description "A programme this entity takes part in."@en ;
    sh:class compass:Programme .

# No sh:class: targets are partner organizations, networks or OceanCare itself,
# separate classes.
compass:RelatedOrganizationPropertyShape a sh:Shape ;
    sh:path compass:relatedOrganization ;
    sh:name "Related Organization"@en ;
    sh:name "Verwandte Organisation"@de ;
    sh:description "A related partner organization, network, or OceanCare itself."@en ;
    sh:nodeKind sh:IRI .

# ============================================================
# SHACL Node Shapes: 4 entity types
# Each references the shared named property shapes above.
# ============================================================

compass:InternationalForumShape a sh:NodeShape ;
    sh:targetClass compass:InternationalForum ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    rdfs:label "International Forum Shape"@en ;
    rdfs:label "Internationales Forum-Form"@de ;
    rdfs:comment "Validates the expected structure of an international ocean governance forum."@en ;
    sh:property compass:NameShape ;
    sh:property [ sh:path rdfs:label ; sh:datatype rdf:langString ;
                  sh:minCount 2 ; sh:uniqueLang true ; sh:languageIn ( "en" "de" ) ] ;
    sh:property compass:WpEntityTagIdShape ;
    sh:property compass:LatShape ;
    sh:property compass:LongShape ;
    sh:property compass:LocationShape ;
    sh:property compass:WebsiteUrlShape ;
    sh:property compass:ImageShape ;
    sh:property compass:DescriptionShape ;
    sh:property compass:AltLabelShape ;
    sh:property compass:ManagedByOceanCareShape ;
    sh:property compass:WorkAreaPropertyShape ;
    sh:property compass:TopicPropertyShape ;
    sh:property compass:SpeciesPropertyShape ;
    sh:property compass:CountryAreaPropertyShape ;
    sh:property compass:RelatedOrganizationPropertyShape ;
    sh:property compass:ProgrammePropertyShape .

compass:NetworkShape a sh:NodeShape ;
    sh:targetClass compass:Network ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    rdfs:label "Network Shape"@en ;
    rdfs:label "Netzwerk-Form"@de ;
    rdfs:comment "Validates the expected structure of a collaborative ocean network."@en ;
    sh:property compass:NameShape ;
    sh:property [ sh:path rdfs:label ; sh:datatype rdf:langString ;
                  sh:minCount 2 ; sh:uniqueLang true ; sh:languageIn ( "en" "de" ) ] ;
    sh:property compass:WpEntityTagIdShape ;
    sh:property compass:LatShape ;
    sh:property compass:LongShape ;
    sh:property compass:LocationShape ;
    sh:property compass:WebsiteUrlShape ;
    sh:property compass:ImageShape ;
    sh:property compass:DescriptionShape ;
    sh:property compass:AltLabelShape ;
    sh:property compass:ManagedByOceanCareShape ;
    sh:property compass:WorkAreaPropertyShape ;
    sh:property compass:TopicPropertyShape ;
    sh:property compass:SpeciesPropertyShape ;
    sh:property compass:CountryAreaPropertyShape ;
    sh:property compass:ForumPropertyShape ;
    sh:property compass:RelatedOrganizationPropertyShape ;
    sh:property compass:ProgrammePropertyShape .

compass:HostOrganizationShape a sh:NodeShape ;
    sh:targetClass compass:HostOrganization ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    rdfs:label "Host Organization Shape"@en ;
    rdfs:label "Trägerorganisation-Form"@de ;
    rdfs:comment "Validates the expected structure of the organization the map belongs to."@en ;
    sh:property compass:NameShape ;
    sh:property [ sh:path rdfs:label ; sh:datatype rdf:langString ;
                  sh:minCount 2 ; sh:uniqueLang true ; sh:languageIn ( "en" "de" ) ] ;
    sh:property compass:WpEntityTagIdShape ;
    sh:property compass:LatShape ;
    sh:property compass:LongShape ;
    sh:property compass:LocationShape ;
    sh:property compass:WebsiteUrlShape ;
    sh:property compass:ImageShape ;
    sh:property compass:DescriptionShape ;
    sh:property compass:AltLabelShape ;
    sh:property compass:ManagedByOceanCareShape ;
    sh:property compass:WorkAreaPropertyShape ;
    sh:property compass:TopicPropertyShape ;
    sh:property compass:SpeciesPropertyShape ;
    sh:property compass:CountryAreaPropertyShape ;
    sh:property compass:ForumPropertyShape ;
    sh:property compass:RelatedOrganizationPropertyShape ;
    sh:property compass:ProgrammePropertyShape .

compass:PartnerOrganizationShape a sh:NodeShape ;
    sh:targetClass compass:PartnerOrganization ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    rdfs:label "Partner Organization Shape"@en ;
    rdfs:label "Partnerorganisation-Form"@de ;
    rdfs:comment "Validates the expected structure of an OceanCare partner organization."@en ;
    sh:property compass:NameShape ;
    sh:property [ sh:path rdfs:label ; sh:datatype rdf:langString ;
                  sh:minCount 2 ; sh:uniqueLang true ; sh:languageIn ( "en" "de" ) ] ;
    sh:property compass:WpEntityTagIdShape ;
    sh:property compass:LatShape ;
    sh:property compass:LongShape ;
    sh:property compass:LocationShape ;
    sh:property compass:WebsiteUrlShape ;
    sh:property compass:ImageShape ;
    sh:property compass:DescriptionShape ;
    sh:property compass:AltLabelShape ;
    sh:property compass:ManagedByOceanCareShape ;
    sh:property compass:WorkAreaPropertyShape ;
    sh:property compass:TopicPropertyShape ;
    sh:property compass:SpeciesPropertyShape ;
    sh:property compass:CountryAreaPropertyShape ;
    sh:property compass:ForumPropertyShape ;
    sh:property compass:RelatedOrganizationPropertyShape ;
    sh:property compass:ProgrammePropertyShape .

# ============================================================
# SKOS Vocabulary
# ============================================================

skos:Concept a rdfs:Class ;
    rdfs:label "Concept"@en ;
    rdfs:label "Konzept"@de ;
    rdfs:comment "A SKOS concept: one selectable tag value within a dimension vocabulary."@en .

skos:ConceptScheme a rdfs:Class ;
    rdfs:label "Concept Scheme"@en ;
    rdfs:label "Konzeptschema"@de ;
    rdfs:comment "A SKOS concept scheme: the vocabulary backing one filter dimension."@en .

skos:definition a rdf:Property ;
    rdfs:label "definition"@en ;
    rdfs:comment "A complete explanation of the intended meaning of a concept or scheme."@en .

skos:inScheme a rdf:Property ;
    rdfs:label "in scheme"@en ;
    rdfs:comment "The concept scheme a concept belongs to."@en .

skos:topConceptOf a rdf:Property ;
    rdfs:label "top concept of"@en ;
    rdfs:comment "The concept scheme this concept is a top-level entry of."@en .

skos:hasTopConcept a rdf:Property ;
    rdfs:label "has top concept"@en ;
    rdfs:comment "A top-level concept of this concept scheme."@en .

dct:isPartOf a rdf:Property ;
    rdfs:label "is part of"@en ;
    rdfs:comment "A larger resource this one is a component of."@en .

compass:ConceptShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    rdfs:label "Concept Shape"@en ;
    rdfs:label "Konzept-Form"@de ;
    rdfs:comment "Validates one tag value in vocab.ttl. Validation only: it targets no compass:MapEntity subclass, so nothing here reaches the map."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:datatype rdf:langString ;
        sh:minCount 2 ;
        sh:uniqueLang true ;
        sh:languageIn ( "en" "de" ) ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:datatype rdf:langString ;
        sh:maxCount 2 ;
        sh:uniqueLang true ;
        sh:languageIn ( "en" "de" ) ;
    ] ;
    sh:property [
        sh:path skos:inScheme ;
        sh:class skos:ConceptScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path skos:topConceptOf ;
        sh:class skos:ConceptScheme ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path compass:wpTagId ;
        sh:datatype xsd:integer ;
        sh:maxCount 1 ;
    ] ;
    sh:property [
        sh:path compass:isoCode ;
        sh:datatype xsd:string ;
        sh:maxCount 1 ;
        sh:pattern "^[A-Z]{3}( [A-Z]{3})*$" ;
    ] .

compass:ConceptSchemeShape a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    rdfs:label "Concept Scheme Shape"@en ;
    rdfs:label "Konzeptschema-Form"@de ;
    rdfs:comment "Validates one dimension vocabulary in vocab.ttl. Validation only: it targets no compass:MapEntity subclass, so nothing here reaches the map."@en ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:datatype rdf:langString ;
        sh:minCount 2 ;
        sh:uniqueLang true ;
        sh:languageIn ( "en" "de" ) ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:datatype rdf:langString ;
        sh:maxCount 2 ;
        sh:uniqueLang true ;
        sh:languageIn ( "en" "de" ) ;
    ] ;
    sh:property [
        sh:path skos:hasTopConcept ;
        sh:class skos:Concept ;
        sh:minCount 1 ;
    ] ;
    sh:property [
        sh:path dct:isPartOf ;
        sh:nodeKind sh:IRI ;
        sh:maxCount 1 ;
    ] .
